#!/usr/bin/env bash

DIR="$HOME/Pictures/Screenshots"
mkdir -p "$DIR"

FILE="$DIR/$(date +%Y-%m-%d_%H-%M-%S).png"

if [[ "$1" == "region" ]]; then
    AREA=$(slurp) || exit 0
    grim -g "$AREA" "$FILE" || exit 1
else
    grim "$FILE" || exit 1
fi

wl-copy < "$FILE"
notify-send "Скриншот сохранён" "$FILE"
