
[global]
    monitor = 0
    follow = none

    width = (320, 380)
    height = (0, 300)
    origin = top-right
    offset = (12, 40)

    notification_limit = 8
    progress_bar = true
    progress_bar_height = 8
    progress_bar_min_width = 160
    progress_bar_max_width = 320
    progress_bar_corner_radius = 999

    padding = 14
    horizontal_padding = 14
    text_icon_padding = 12

    frame_width = 1
    frame_color = "#9ccfd8"
    gap_size = 8
    separator_height = 0
    separator_color = frame

    font = Sans 10
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    word_wrap = yes
    ellipsize = middle

    icon_position = left
    max_icon_size = 48
    corner_radius = 14
    corners = all

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#181a21"
    foreground = "#777d8c"
    frame_color = "#303746"
    timeout = 5

[urgency_normal]
    background = "#181a21"
    foreground = "#e0def4"
    frame_color = "#9ccfd8"
    timeout = 6

[urgency_critical]
    background = "#211820"
    foreground = "#e0def4"
    frame_color = "#eb6f92"
    timeout = 0
